<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Offline-first by design. INTERNET exists solely for update checks
         (a silent once-per-launch GitHub releases check + the user-initiated
         "Check for updates" flow and its APK download) — no periodic network,
         analytics or telemetry. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Needed so the downloaded update APK can be handed to the system
         package installer. Android still asks the user to allow installs
         from this app first. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- allowBackup is false: the About sheet promises "your data never leaves
         this device." Auto Backup to Google Drive would copy the Room history
         and DataStore preferences off-device, contradicting that claim. -->
    <application
        android:name=".ToadApplication"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ToadCalculator.Splash">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ToadCalculator.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
