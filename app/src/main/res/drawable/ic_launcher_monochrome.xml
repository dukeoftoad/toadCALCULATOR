<!--
  toadCALCULATOR monochrome launcher layer — same Calculator-Toad geometry as
  ic_launcher_foreground, built for alpha-based tinting. The system renders
  every opaque pixel in a single theme color, so face details are expressed as
  TRANSPARENT HOLES (fillType evenOdd) instead of contrasting ink: the display,
  the smile band and the six keypad keys are punched out of the body, and the
  pupils are punched out of the eye bumps. The "=" stays opaque so it floats
  inside the display hole. Replaces the v1.0 arrangement (foreground doubling
  as monochrome, which tinted into a featureless silhouette).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Front feet (solid, drawn first; the body covers their overlap). -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M42.5,78.2 m-6.5,0 a6.5,2.4 0 1,0 13,0 a6.5,2.4 0 1,0 -13,0 M65.5,78.2 m-6.5,0 a6.5,2.4 0 1,0 13,0 a6.5,2.4 0 1,0 -13,0" />

    <!-- Body with display / smile / keypad punched out (evenOdd). -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M41,43 h26 a8,8 0 0 1 8,8 v18 a8,8 0 0 1 -8,8 h-26 a8,8 0 0 1 -8,-8 v-18 a8,8 0 0 1 8,-8 z
            M42,48.5 h24 a3,3 0 0 1 3,3 v3 a3,3 0 0 1 -3,3 h-24 a3,3 0 0 1 -3,-3 v-3 a3,3 0 0 1 3,-3 z
            M43,59.2 Q54,65.2 65,59.2 L65,62.4 Q54,68.4 43,62.4 Z
            M43,68.6 m-2.1,0 a2.1,2.1 0 1,0 4.2,0 a2.1,2.1 0 1,0 -4.2,0
            M54,68.6 m-2.1,0 a2.1,2.1 0 1,0 4.2,0 a2.1,2.1 0 1,0 -4.2,0
            M65,68.6 m-2.1,0 a2.1,2.1 0 1,0 4.2,0 a2.1,2.1 0 1,0 -4.2,0
            M43,73.2 m-2.1,0 a2.1,2.1 0 1,0 4.2,0 a2.1,2.1 0 1,0 -4.2,0
            M54,73.2 m-2.1,0 a2.1,2.1 0 1,0 4.2,0 a2.1,2.1 0 1,0 -4.2,0
            M65,73.2 m-2.1,0 a2.1,2.1 0 1,0 4.2,0 a2.1,2.1 0 1,0 -4.2,0" />

    <!-- Eye bumps with pupil holes (evenOdd donuts), drawn over the body. -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M45,39.5 m-7.5,0 a7.5,7.5 0 1,0 15,0 a7.5,7.5 0 1,0 -15,0 M46.8,41.3 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" />
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M63,39.5 m-7.5,0 a7.5,7.5 0 1,0 15,0 a7.5,7.5 0 1,0 -15,0 M61.2,41.3 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" />

    <!-- "=" floats inside the display hole. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:pathData="M48,51.7 H60" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:pathData="M48,54.3 H60" />
</vector>
