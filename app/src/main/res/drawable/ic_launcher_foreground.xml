        android:pathData="M36,43 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0 M60,43 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0" />

    <!-- Front feet peeking under the body. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M38.5,75 A6.5,3 0 1,0 51.5,75 A6.5,3 0 1,0 38.5,75 M56.5,75 A6.5,3 0 1,0 69.5,75 A6.5,3 0 1,0 56.5,75" />

